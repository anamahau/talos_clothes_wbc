<launch>

    <!-- Load controllers -->
    <node pkg="rosservice" type="rosservice" name="load_left"
          args="call /controller_manager/load_controller 'name: left_gripper_controller'" />

    <node pkg="rosservice" type="rosservice" name="load_right"
          args="call /controller_manager/load_controller 'name: right_gripper_controller'" />

    <!-- Start left -->
    <node pkg="rosservice" type="rosservice" name="start_left"
          args="call /controller_manager/switch_controller 
          '{start_controllers: [left_gripper_controller], stop_controllers: [], strictness: 0}'" />

    <!-- Start right -->
    <node pkg="rosservice" type="rosservice" name="start_right"
          args="call /controller_manager/switch_controller 
          '{start_controllers: [right_gripper_controller], stop_controllers: [], strictness: 0}'" />

</launch>