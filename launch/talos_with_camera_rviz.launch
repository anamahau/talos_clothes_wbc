<launch>

  <!-- your normal sim + RViz, unmodified -->
  <include file="$(find talos_pal_physics_simulator)/launch/talos_pal_physics_simulator.launch"/>

  <!-- camera-only robot_description + its internal TF -->
  <include file="$(find talos_clothes_wbc)/launch/robot_state_publisher.launch"/>

  <!-- glue: real TALOS head frame -> camera's dummy root -->
  <!-- args: x y z qx qy qz qw  parent_frame  child_frame -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="head_to_camera_extra"
        args="0.035 -0.10965 -0.05616  0.0 0.0 0.0 1.0  rgbd_optical_frame  camera_dummy_root"/>
        <!-- args="0.03 0.0 0.5  -0.5 0.5 -0.5 0.5  head_2_link  camera_dummy_root"/> -->

</launch>